{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lead enrichment evidence envelope",
  "oneOf": [
    { "$ref": "#/$defs/EvidenceClaim" },
    { "$ref": "#/$defs/VerifierDecision" },
    { "$ref": "#/$defs/ResearchRun" },
    { "$ref": "#/$defs/AccountIndicator" },
    { "$ref": "#/$defs/SemanticReview" },
    { "$ref": "#/$defs/CoverageManifest" }
  ],
  "$defs": {
    "EvidenceClaim": {
      "type": "object",
      "required": ["record_type", "candidate_claim_id", "candidate_sha256", "company_id", "claim_type", "claim_value", "source_url", "source_kind", "evidence_excerpt", "retrieved_at", "account_relationship", "confidence", "research_run_id", "candidate_status"],
      "properties": {
        "record_type": { "const": "EvidenceClaim" },
        "candidate_claim_id": { "type": "string", "minLength": 1 },
        "candidate_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "company_id": { "type": "string", "minLength": 1 },
        "claim_type": { "type": "string", "minLength": 1 },
        "claim_value": {},
        "unit": { "type": ["string", "null"] },
        "scope": { "type": ["string", "null"] },
        "source_url": { "type": "string", "format": "uri" },
        "source_domain": { "type": ["string", "null"] },
        "source_kind": { "type": "string", "minLength": 1 },
        "evidence_excerpt": { "type": "string", "minLength": 1 },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "published_at": { "type": ["string", "null"], "format": "date" },
        "as_of_date": { "type": ["string", "null"], "format": "date" },
        "account_relationship": { "enum": ["direct", "same_domain", "directory", "inferred", "unknown"] },
        "confidence": { "enum": ["high", "medium", "low", "unknown"] },
        "research_run_id": { "type": "string", "minLength": 1 },
        "candidate_status": { "enum": ["Candidate", "Supported", "Verified", "Rejected", "Needs review"] },
        "assurance_level": { "enum": ["replay", "structural", "source", "unknown"] },
        "person_name": { "type": ["string", "null"] },
        "role": { "type": ["string", "null"] },
        "company_affiliation": { "type": ["string", "null"] },
        "email": { "type": ["string", "null"] },
        "verifier_run_id": { "type": ["string", "null"] },
        "verified_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "allOf": [
        { "if": { "properties": { "claim_type": { "enum": ["buying_signal", "event"] } } }, "then": { "required": ["published_at"] } },
        { "if": { "properties": { "claim_type": { "enum": ["portfolio_size", "portfolio_value"] } } }, "then": { "required": ["unit", "scope", "as_of_date"] } },
        { "if": { "properties": { "claim_type": { "const": "contact" } } }, "then": { "required": ["person_name", "role", "company_affiliation"] } }
      ],
      "additionalProperties": false
    },
    "VerifierDecision": {
      "type": "object",
      "required": ["record_type", "candidate_claim_id", "candidate_sha256", "decision", "reason_codes", "verifier_id", "verifier_run_id", "verified_at"],
      "properties": {
        "record_type": { "const": "VerifierDecision" },
        "candidate_claim_id": { "type": "string", "minLength": 1 },
        "candidate_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "decision": { "enum": ["Verified", "Rejected", "Needs review"] },
        "reason_codes": { "type": "array", "items": { "type": "string" } },
        "verifier_id": { "type": "string", "minLength": 1 },
        "verifier_run_id": { "type": "string", "minLength": 1 },
        "assurance_level": { "enum": ["replay", "structural", "source", "unknown"] },
        "verified_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "ResearchAttempt": {
      "type": "object",
      "required": ["attempt_id", "query_or_source", "status", "truncated"],
      "properties": {
        "attempt_id": { "type": "string", "minLength": 1 },
        "query_or_source": { "type": "string", "minLength": 1 },
        "provider": { "type": ["string", "null"] },
        "page_or_cursor": { "type": ["string", "integer", "null"] },
        "cap": { "type": ["integer", "null"], "minimum": 0 },
        "truncated": { "type": "boolean" },
        "status": { "enum": ["Completed", "Partial", "Unavailable", "Needs review"] },
        "error_code": { "type": ["string", "null"] },
        "candidate_claim_ids": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "ResearchRun": {
      "type": "object",
      "required": ["record_type", "run_id", "company_id", "research_type", "source", "scope", "status", "started_at", "completed_at", "result_count", "truncated", "provider_status", "scope_version", "scope_hash", "attempts"],
      "properties": {
        "record_type": { "const": "ResearchRun" },
        "run_id": { "type": "string", "minLength": 1 },
        "campaign_id": { "type": "string", "minLength": 1 },
        "company_id": { "type": "string", "minLength": 1 },
        "company_name": { "type": "string" },
        "trusted_domain": { "type": "string" },
        "location": { "type": "string" },
        "research_type": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "status": { "enum": ["Not searched", "Completed", "Partial", "Unavailable", "Needs review"] },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" },
        "result_count": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "provider_status": { "enum": ["Available", "Unavailable", "Invalid", "Unknown"] },
        "adapter_capability": { "type": "string", "minLength": 1 },
        "assurance_level": { "enum": ["replay", "structural", "source", "unknown"] },
        "error_code": { "type": ["string", "null"] },
        "required_checks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "completed_checks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "stop_reason": { "type": ["string", "null"] },
        "coverage_status": { "enum": ["complete", "partial", "unavailable", "unknown"] },
        "scope_version": { "type": "string", "minLength": 1 },
        "scope_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "attempts": { "type": "array", "items": { "$ref": "#/$defs/ResearchAttempt" } }
      },
      "additionalProperties": false
    },
    "AccountIndicator": {
      "type": "object",
      "required": ["record_type", "company_id", "offer_id", "offer_version", "indicator_type", "statement", "strength", "confidence", "supporting_claim_ids", "offer_criterion"],
      "properties": {
        "record_type": { "const": "AccountIndicator" },
        "company_id": { "type": "string", "minLength": 1 },
        "offer_id": { "type": "string", "minLength": 1 },
        "offer_version": { "type": "string", "minLength": 1 },
        "indicator_type": { "enum": ["direct_intent", "trigger", "need_indicator", "change_readiness"] },
        "statement": { "type": "string", "minLength": 1 },
        "strength": { "type": "number", "minimum": 0, "maximum": 100 },
        "recency": { "type": ["string", "null"], "format": "date" },
        "confidence": { "enum": ["low", "medium", "high"] },
        "supporting_claim_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "counterevidence_claim_ids": { "type": "array", "items": { "type": "string" } },
        "offer_criterion": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "SemanticReview": {
      "type": "object",
      "required": ["record_type", "assertion_id", "company_id", "offer_id", "offer_version", "reviewed_claim_ids", "offer_criterion", "entailment", "offer_relevance", "temporal_relevance", "contradiction_result", "decision", "reason_codes", "reviewer_id"],
      "properties": {
        "record_type": { "const": "SemanticReview" },
        "assertion_id": { "type": "string", "minLength": 1 },
        "company_id": { "type": "string", "minLength": 1 },
        "offer_id": { "type": "string", "minLength": 1 },
        "offer_version": { "type": "string", "minLength": 1 },
        "reviewed_claim_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "offer_criterion": { "type": "string", "minLength": 1 },
        "entailment": { "enum": ["supported", "unsupported", "unclear"] },
        "offer_relevance": { "enum": ["relevant", "irrelevant", "unclear"] },
        "temporal_relevance": { "enum": ["current", "stale", "unknown"] },
        "contradiction_result": { "enum": ["none", "present", "unclear"] },
        "decision": { "enum": ["approved", "rejected", "needs_review"] },
        "reason_codes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "reviewer_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "CoverageManifest": {
      "type": "object",
      "required": ["record_type", "company_id", "offer_id", "offer_version", "required_checks", "completed_checks", "provider_states", "truncated", "unresolved_candidates", "trigger_state"],
      "properties": {
        "record_type": { "const": "CoverageManifest" },
        "company_id": { "type": "string", "minLength": 1 },
        "offer_id": { "type": "string", "minLength": 1 },
        "offer_version": { "type": "string", "minLength": 1 },
        "required_checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "completed_checks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "provider_states": { "type": "object", "additionalProperties": { "enum": ["available", "unavailable", "invalid", "unknown"] } },
        "truncated": { "type": "boolean" },
        "unresolved_candidates": { "type": "integer", "minimum": 0 },
        "trigger_state": { "enum": ["Verified trigger", "No trigger found", "Research incomplete", "Unavailable"] }
      },
      "additionalProperties": false
    }
  }
}
