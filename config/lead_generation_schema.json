{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Berlin Hausverwaltung Lead Generation Record",
  "type": "object",
  "required": ["company_id", "company_name", "source_url", "retrieved_at", "evidence_level"],
  "properties": {
    "company_id": {"type": "string", "minLength": 1},
    "company_name": {"type": "string", "minLength": 1},
    "legal_name": {"type": ["string", "null"]},
    "domain": {"type": ["string", "null"]},
    "address": {"type": ["string", "null"]},
    "postal_code": {"type": ["string", "null"]},
    "city": {"type": ["string", "null"]},
    "region": {"type": ["string", "null"]},
    "berlin_relevance": {"enum": ["Confirmed", "Probable", "Unknown"]},
    "management_type": {"enum": ["Hausverwaltung", "WEG-Verwaltung", "Mietverwaltung", "Sondereigentumsverwaltung", "Mixed", "Unknown"]},
    "residential_weg": {"enum": ["Confirmed", "Probable", "Not evident", "Unknown"]},
    "portfolio_size": {"type": ["number", "null"], "minimum": 0},
    "portfolio_size_status": {"enum": ["Confirmed", "Probable", "Unknown"]},
    "service_fit": {"enum": ["Confirmed", "Probable", "Not evident", "Unknown"]},
    "source_type": {"type": "string"},
    "source_reuse_status": {"enum": ["New retrieval", "Existing export", "Manual review", "Unknown"]},
    "extraction_method": {"type": "string"},
    "actor_id": {"type": ["string", "null"]},
    "actor_run_id": {"type": ["string", "null"]},
    "source_record_id": {"type": ["string", "null"]},
    "source_url": {"type": "string", "format": "uri"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "evidence_level": {"enum": ["Primary", "Secondary", "Tertiary", "Unknown"]},
    "evidence_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "signal_search_status": {"enum": ["Searched", "Not searched", "Unavailable", "Unknown"]},
    "buying_signal": {"enum": ["Verified trigger", "Strong", "Medium", "Weak", "No trigger found", "Research incomplete", "Unavailable", "None found", "Unknown"]},
    "offer_id": {"type": ["string", "null"]},
    "offer_version": {"type": ["string", "null"]},
    "priority_state": {"enum": ["Priority — verified trigger", "Priority — strong fit, no trigger", "Nurture", "Research required", "Disqualify"]},
    "why_this_account": {"type": ["string", "null"]},
    "why_now": {"type": ["string", "null"]},
    "problem_hypothesis": {"type": ["string", "null"]},
    "strongest_claim_ids": {"type": "array", "items": {"type": "string"}},
    "counterevidence_claim_ids": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "access_summary": {"type": ["string", "null"]},
    "research_gap_impact": {"type": ["string", "null"]},
    "rank_audit": {"type": ["object", "null"]},
    "actionability": {"enum": ["Ready", "Research", "Monitor", "Unknown"]},
    "structural_lead_fit": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "evidence_coverage": {"type": "number", "minimum": 0, "maximum": 100},
    "sales_priority": {"enum": ["Pursue", "Research", "Defer"]},
    "assurance_level": {"enum": ["replay", "structural", "source", "unknown"]},
    "provider_status": {"enum": ["Available", "Unavailable", "Unknown"]},
    "research_gap": {"type": "string"},
    "next_action": {"type": "string"},
    "lead_tier": {"enum": ["A", "B", "C", "Research"]},
    "contact_name": {"type": ["string", "null"]},
    "contact_role": {"type": ["string", "null"]},
    "contact_email": {"type": ["string", "null"], "format": "email"},
    "email_source": {"type": ["string", "null"], "format": "uri"},
    "email_status": {"enum": ["Verified", "Published", "Unverified", "Not found", "Unknown"]},
    "verification_status": {"enum": ["Verified", "Published", "Unverified", "Accept-all", "Not found", "Unknown"]},
    "linkedin_url": {"type": ["string", "null"], "format": "uri"},
    "last_verified": {"type": ["string", "null"], "format": "date"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"service_fit": {"not": {"const": "Unknown"}}}}, "then": {"required": ["evidence_urls"]}},
    {"if": {"properties": {"residential_weg": {"not": {"const": "Unknown"}}}}, "then": {"required": ["evidence_urls"]}},
    {"if": {"properties": {"contact_email": {"type": "string"}}}, "then": {"required": ["email_source", "verification_status", "last_verified"]}}
  ]
}
