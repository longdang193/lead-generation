{
  "registry_version": "1",
  "evidence_statuses": {
    "DISCOVERY": {
      "description": "Locates possible companies, URLs, people, or events; cannot support canonical claims.",
      "promotable_without_verification": false
    },
    "CANDIDATE_EVIDENCE": {
      "description": "Captures a company-bound source excerpt for later verification.",
      "promotable_without_verification": false
    },
    "VERIFIED_EVIDENCE": {
      "description": "A verifier confirmed identity, entailment, freshness, offer relevance, and contradictions.",
      "promotable_without_verification": true
    }
  },
