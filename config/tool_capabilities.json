{
  "registry_version": "2",
  "historical_search_policy": {
    "purpose": "Describe bounded historical-search capability without implying complete historical coverage.",
    "discovery_is_not_verification": true,
    "required_verification": [
      "exact company-bound source",
      "original publication or event date",
      "retrieval time",
      "coverage and truncation status"
    ],
    "completeness_claims": "Do not claim historical completeness unless the provider explicitly proves coverage for the requested window."
  },
  "evidence_statuses": {
    "DISCOVERY": {
      "description": "Locates possible companies, URLs, people, or events; cannot support canonical claims.",
      "promotable_without_verification": false
    },
    "CANDIDATE_EVIDENCE": {
      "description": "Captures a company-bound source excerpt for later verification.",
      "promotable_without_verification": false
    },
    "VERIFIED_EVIDENCE": {
      "description": "A verifier confirmed identity, entailment, freshness, offer relevance, and contradictions.",
      "promotable_without_verification": true
    }
  },
  "capabilities": {
    "web_search": {
      "providers": ["apify"],
      "default_evidence_status": "DISCOVERY",
      "evidence_role": "discovery_only",
      "historical_support": "bounded_search_only; snippets and result ordering are not a historical baseline"
    },
    "search_engine": {
      "providers": ["apify"],
      "default_evidence_status": "DISCOVERY",
      "evidence_role": "discovery_only"
    },
    "news_search": {
      "providers": ["apify"],
      "default_evidence_status": "DISCOVERY",
      "evidence_role": "discovery_only",
      "historical_support": "bounded dated-result discovery; provider coverage may be incomplete"
    },
    "jobs_search": {
      "providers": ["apify"],
      "default_evidence_status": "DISCOVERY",
      "evidence_role": "discovery_only",
      "historical_support": "current or bounded dated-result discovery; do not infer hiring trends from one result"
    },
    "place_discovery": {
      "providers": ["overpass"],
      "default_evidence_status": "DISCOVERY",
      "evidence_role": "candidate_discovery"
    },
    "procurement_search": {
      "providers": ["ted"],
      "default_evidence_status": "DISCOVERY",
      "evidence_role": "discovery_or_candidate_intent",
      "historical_support": "bounded dated-event discovery; absence is not evidence of no procurement"
    },
    "official_source_fetch": {
      "providers": ["website_fetch"],
      "default_evidence_status": "CANDIDATE_EVIDENCE",
      "evidence_role": "candidate_evidence",
      "historical_support": "only dates and historical comparisons explicitly present on the fetched source"
    },
    "source_fetch": {
      "providers": ["website_fetch"],
      "default_evidence_status": "CANDIDATE_EVIDENCE",
      "evidence_role": "candidate_evidence"
    },
    "identity_resolution": {
      "providers": ["website_fetch"],
      "default_evidence_status": "CANDIDATE_EVIDENCE",
      "evidence_role": "candidate_evidence"
    },
    "identity_check": {
      "providers": ["evidence_verifier"],
      "default_evidence_status": "VERIFIED_EVIDENCE",
      "evidence_role": "identity_verification"
    },
    "contact_enrichment": {
      "providers": ["hunter"],
      "default_evidence_status": "CANDIDATE_EVIDENCE",
      "evidence_role": "supplemental_contact"
    },
    "contact_verification": {
      "providers": ["website_fetch"],
      "default_evidence_status": "CANDIDATE_EVIDENCE",
      "evidence_role": "candidate_evidence"
    },
    "professional_profile_search": {
      "providers": ["apify"],
      "default_evidence_status": "DISCOVERY",
      "evidence_role": "discovery_only"
    },
    "capture_evidence": {
      "providers": ["lead_evidence"],
      "default_evidence_status": "CANDIDATE_EVIDENCE",
      "evidence_role": "candidate_evidence"
    },
    "validate_evidence": {
      "providers": ["evidence_verifier"],
      "default_evidence_status": "VERIFIED_EVIDENCE",
      "evidence_role": "verification"
    },
    "semantic_review": {
      "providers": ["codex_parent_or_subagent"],
      "default_evidence_status": "VERIFIED_EVIDENCE",
      "evidence_role": "semantic_verification"
    },
    "promote_evidence": {
      "providers": ["promote_evidence"],
      "default_evidence_status": "VERIFIED_EVIDENCE",
      "evidence_role": "deterministic_promotion"
    },
    "permitted_directory": {
      "providers": ["apify"],
      "default_evidence_status": "DISCOVERY",
      "evidence_role": "discovery_only"
    }
  }
}
